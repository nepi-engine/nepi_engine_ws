+    def updateGeoidHeight(self, latitude, longitude):
+        # Geoid height N at the location, looked up again only once the location
+        # has moved GEOID_UPDATE_DIST_DEG from the last lookup point. (0,0) keeps
+        # the last value. A missing geoid database or a failed lookup keeps the
+        # last value (0 until a lookup succeeds) with a throttled warning, as the
+        # ArduPilot driver does.
+        if latitude == 0 and longitude == 0:
+            return
+        if self.geoid_lookup_geo is not None:
+            if abs(latitude - self.geoid_lookup_geo[0]) < self.GEOID_UPDATE_DIST_DEG and \
+               abs(longitude - self.geoid_lookup_geo[1]) < self.GEOID_UPDATE_DIST_DEG:
+                return
+        if nepi_nav.file_loaded == False:
+            self.msg_if.pub_warn("Geoid database not loaded (" + nepi_nav.GEOID_DATABASE_FILE + "), geoid height stays 0, so the GPS_INPUT altitude is not AMSL-corrected", throttle_s = 60.0)
+            return
+        try:
+            geopoint = GeoPoint()
+            geopoint.latitude = latitude
+            geopoint.longitude = longitude
+            self.geoid_height_m = float(nepi_nav.get_navpose_geoid_height_at_geopoint(geopoint))
+            self.geoid_lookup_geo = [latitude, longitude]
+        except Exception as e:
+            self.msg_if.pub_warn("Geoid height lookup failed, keeping " + str(self.geoid_height_m) + " m: " + str(e), throttle_s = 60.0)
